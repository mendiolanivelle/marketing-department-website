# Public browser configuration (Docker build arguments)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
VITE_PRIVATE_STORAGE_ENABLED=false

# Node server runtime (Coolify environment)
PORT=3000
PUBLIC_SITE_URL=https://portal.example.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional server tuning
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://portal.example.com
OPENROUTER_APP_NAME=Marketing Department Portal
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000

# Supabase Edge Function configuration belongs in Supabase secrets, not Coolify.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_publishable_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
# PUBLIC_SITE_URL=https://portal.example.com
# OPERATIONS_SITE_URL=https://operations.example.com
# ALLOWED_ORIGINS=https://portal.example.com
# TURNSTILE_SECRET_KEY=your_private_turnstile_secret_key
# EDIT_TOKEN_SIGNING_SECRET=your_random_32_byte_or_longer_secret
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=marketing@example.com

# Optional local file watcher (not used by the production container)
WATCHED_LEADS_DIR=/absolute/path/to/watched-leads
