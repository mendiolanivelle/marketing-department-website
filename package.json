{
  "name": "marketing-department-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "test": "node --test server/index.test.mjs scripts/validate-public-env.test.mjs scripts/staff-boundary.test.mjs scripts/notification-safety.test.mjs scripts/private-storage-safety.test.mjs tools/backfill-legacy-private-storage.test.mjs",
    "test:migrations": "psql -v ON_ERROR_STOP=1 -f scripts/migrations-048-051.test.sql",
    "typecheck": "tsc --noEmit",
    "storage:backfill": "node tools/backfill-legacy-private-storage.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "ai:push": "node scripts/ai-push.mjs",
    "watch:leads": "node scripts/file-watcher.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-router-dom": "7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.0"
  }
}
